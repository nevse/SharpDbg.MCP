<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
      <!-- The debug adapter runs as a child process and has to sit beside this output -->
    <NeedsClrdbgAdapter>true</NeedsClrdbgAdapter>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpDbg.MCP\SharpDbg.MCP.csproj" />
    <!-- Built alongside the tests as a debuggee; not linked, the tests launch it as a process -->
    <ProjectReference Include="..\SharpDbg.MCP.TestApp\SharpDbg.MCP.TestApp.csproj"
                     ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
