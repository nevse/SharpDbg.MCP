<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, and cleared first on purpose. Every package this repository and the clrdbg
       submodule need is public, and a machine with a private feed in its user-level config makes
       restore reach for it: without credentials that blocks for minutes, and it defeats a per-command
       RestoreSources because the adapter build runs its own nested restore. Clearing here also settles
       the NU1507 warning that central package management raises when more than one source is defined. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
