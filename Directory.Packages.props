<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP SDK and Dependencies -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageVersion Include="ModelContextProtocol" Version="0.5.0-preview.1" />

    <!-- Debugging Infrastructure. The debugger itself is the clrdbg submodule, built from source by
         Directory.Build.targets, so it needs no entry here; DbgShim comes with it. -->
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim" Version="9.0.661903" />
    <PackageVersion Include="Microsoft.VisualStudio.Shared.VSCodeDebugProtocol" Version="18.0.10427.1" />

    <!-- Markdown Processing -->
    <PackageVersion Include="Markdig" Version="0.44.0" />

    <!-- Testing -->
    <PackageVersion Include="MSTest" Version="4.0.2" />
  </ItemGroup>
</Project>
