<Project>
  <PropertyGroup>
    <!-- Common compilation settings -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build output -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Build against a clone of https://github.com/MattParkerDev/sharpdbg instead of the package,
         for diagnosing upstream defects. Set the path to the clone as an
         environment variable or on the command line:
           dotnet build -p:SharpDbgSourcePath=/path/to/sharpdbg
         Unset, everything builds against the SharpDbg version in Directory.Packages.props. -->
    <UseLocalSharpDbg Condition="'$(SharpDbgSourcePath)' != ''">true</UseLocalSharpDbg>

    <!-- Repository and package metadata -->
    <Authors>SharpDbg MCP Contributors</Authors>
    <Copyright>Copyright © 2026 SharpDbg MCP Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/nevse/dotnet-debugger-mcp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nevse/dotnet-debugger-mcp</PackageProjectUrl>
  </PropertyGroup>
</Project>
